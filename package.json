{
  "name": "shipboard",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "12.3.4"
  },
  "scripts": {
    "dev:web": "pnpm --filter @shipboard/web dev",
    "dev:api": "pnpm --filter @shipboard/api dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @shipboard/contracts build && pnpm --filter @shipboard/api typecheck && pnpm --filter @shipboard/web typecheck",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:integration": "pnpm --filter @shipboard/api test:integration",
    "build": "pnpm --filter @shipboard/contracts build && pnpm --filter @shipboard/api build && pnpm --filter @shipboard/web build"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "eslint": "9.36.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.1"
  }
}
