# API configuration (safe local defaults)
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000
# Optional OTLP base endpoint, for example: http://localhost:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=shipboard-api

# Set a local password before starting Compose. URL-encode reserved characters
# in the password when constructing DATABASE_URL for the native API.
POSTGRES_DB=shipboard
POSTGRES_USER=shipboard
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://shipboard:replace-with-local-password@127.0.0.1:5432/shipboard

# Optional complete stack: use the same database/user/password, with the Compose
# service hostname and internal port. Set WEB_ORIGIN to the published web URL
# if WEB_PORT is changed. Leave native DATABASE_URL above for native API runs.
COMPOSE_DATABASE_URL=postgresql://shipboard:replace-with-local-password@postgres:5432/shipboard
WEB_PORT=3000
API_PORT=3001
API_INTERNAL_URL=http://api:3001
