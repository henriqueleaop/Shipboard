{
  "name": "@shipboard/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run test/unit src --exclude '**/test/integration/**'",
    "test:integration": "pnpm build && vitest run test/integration --maxWorkers=1",
    "test:database": "pnpm build && vitest run test/integration/database.test.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "node --env-file-if-exists=../../.env dist/infrastructure/database/migrate.js"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.6",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/type-provider-zod": "1.0.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@shipboard/contracts": "workspace:*",
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "auth": "1.7.6",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "vitest": "3.2.4"
  }
}
